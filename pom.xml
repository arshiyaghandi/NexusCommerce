<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>org.nexuxs</groupId>
    <artifactId>nexus-commerce</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>NexusCommerce</name>
    <description>NexusCommerce Microservices Platform</description>

    <modules>
        <module>discovery-service/discovery</module>
        <module>messaging-service</module>
        <module>api-gateway/gateway</module>
        <module>order-service/order-service</module>
        <module>inventory-service/inventory-service</module>
        <module>product-service/product-service</module>
        <module>cart-service/cart-service</module>
        <module>payment-service/payment-service</module>
        <module>notification-service/notification-service</module>
        <module>finance-service/finance-service</module>
        <module>auth-service/auth</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <messaging-contracts.version>1.0.0-SNAPSHOT</messaging-contracts.version>
        <springdoc.version>2.5.0</springdoc.version>
        <logstash-encoder.version>7.4</logstash-encoder.version>
        <micrometer.version>1.12.5</micrometer.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.nexuxs</groupId>
                <artifactId>messaging-contracts</artifactId>
                <version>${messaging-contracts.version}</version>
            </dependency>
            <!-- Metrics: Micrometer Prometheus registry -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-registry-prometheus</artifactId>
                <version>${micrometer.version}</version>
            </dependency>
            <!-- Logging: Logstash Logback Encoder -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-encoder.version}</version>
            </dependency>
            <!-- API Docs: SpringDoc OpenAPI for WebFlux services -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- API Docs: SpringDoc OpenAPI for WebMVC services -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
